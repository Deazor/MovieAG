<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MovieAG</AssemblyName>
    <ApplicationIcon>movieag.ico</ApplicationIcon>
    <Product>MovieAG</Product>
  </PropertyGroup>

  <!-- Release собирается в один exe со всем .NET внутри: ставить ничего не нужно. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Без этого рядом с exe остаются .pdb библиотек проекта. -->
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MovieAG.Hosting\MovieAG.Hosting.csproj" />
  </ItemGroup>

  <!-- Собранный Angular и пример конфига кладутся рядом с exe; client собирает scripts/publish-desktop.ps1. -->
  <ItemGroup>
    <Content Include="..\..\client\dist\client\browser\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\sources.example.yaml" Link="sources.example.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Пакет WebView2 подключает и WPF-сборку; в WinForms она не нужна и даёт конфликт версий WindowsBase. -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
